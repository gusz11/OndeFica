ENVIRONMENT=development
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY_WITH_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./ondefica_dev.db
AUTO_CREATE_TABLES=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:8081"]
ADMIN_EMAILS=[]
GOOGLE_PLACES_API_KEY=
# Demo keys support Places API (New) without billing, but not user photos/reviews.
# Use standard only with a regular key to request photos and user ratings.
GOOGLE_PLACES_MODE=demo
# Explicit audiences for server-side verification; an empty list disables Google login.
GOOGLE_CLIENT_IDS=[]
